# Copy to .env.local for local development. Never commit real values.
#
# Frontend values are PUBLIC: anything prefixed with VITE_ is embedded in the
# browser bundle. Never put secrets, private keys, or server credentials here.
#
# None of these are required for the default device-only mode. Leave them
# empty until the related optional feature is implemented and enabled.

# Optional base URL of the separately deployed Cloudflare Worker.
# When empty, cloud features stay off and the dashboard remains local-only.
VITE_API_BASE_URL=

# Optional Firebase Authentication (Phase 8). Values come from the Firebase
# console's public web app config. All four are required to enable sign-in;
# leave them all empty to keep the Account page in local-only mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
